# Copy to .env and fill in locally (never commit .env)
FINNHUB_API_KEY=

# Absolute path to the Standing git checkout (directory that contains config/scoring.yaml).
# Required on homelab/Docker if the process cwd is not the repo root.
# STANDING_ROOT=/opt/standing

# Optional override for the portfolio/journal SQLite file (default: $STANDING_ROOT/artifacts/portfolio/standing.db)
# STANDING_PORTFOLIO_DB=/var/lib/standing/standing.db

# Desk defaults
# STANDING_MARKET=live
# STANDING_SOCIAL=open
# Prefer immutable day logs from `standing ingest` (set 0 to always live-compute)
# STANDING_PREFER_STORE=1
