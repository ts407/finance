# Copy to .env and fill in locally (never commit .env)
FINNHUB_API_KEY=

# Absolute path to the Standing git checkout (directory that contains config/scoring.yaml).
# Required on homelab/Docker if the process cwd is not the repo root.
# STANDING_ROOT=/opt/standing

# Machine-local personal data lives on the homelab tank, NOT in git and NOT on the Mac.
#   /tank/finance/data/portfolio/standing.db
#   /tank/finance/data/diary/{positions.json,diary.jsonl}
STANDING_DATA_DIR=/tank/finance/data

# Optional per-store overrides (otherwise $STANDING_DATA_DIR/portfolio and .../diary)
# STANDING_PORTFOLIO_DB=/tank/finance/data/portfolio/standing.db
# STANDING_DESK_DIR=/tank/finance/data/diary

# Desk defaults
# STANDING_MARKET=live
# STANDING_SOCIAL=open
# Prefer immutable day logs from `standing ingest` (set 0 to always live-compute)
# STANDING_PREFER_STORE=1
